# Copy to .env and fill in. See docs/BACKEND_SPEC.md section 12.
DATABASE_URL="file:./data/canvass.db"
AUTH_SECRET="replace-with-32-plus-random-bytes-base64url........"
APP_BASE_URL="http://localhost:3000"

# Geocoding, Places (New) and Routes APIs enabled; IP-restricted in production
GOOGLE_MAPS_API_KEY=""
# Only for routing.provider = GOOGLE
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

OUTBOUND_WEBHOOK_SECRET="replace-with-32-plus-random-bytes................"
MEDIA_SIGNING_SECRET="replace-with-32-plus-random-bytes................"
UPLOAD_DIR="./data/uploads"

# First boot only: prisma/seed.ts creates this admin if no users exist
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# Optional
NEXT_PUBLIC_MAP_STYLE_URL=""
WORKER_ID=""
